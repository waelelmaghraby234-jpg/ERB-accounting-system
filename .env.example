DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_GROUP_CODE=GROUP001
ADMIN_GROUP_NAME=Cairo Group Holding
AUTO_MIGRATE=true
DB_POOL_MAX=10
# Enable only during controlled testing. Disable again after use.
ALLOW_COMPANY_RESET=false
ALLOW_TEST_UNPOST=false
